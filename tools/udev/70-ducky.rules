# SPDX-License-Identifier: GPL-2.0-or-later
# Ducky One 3 (every model but the Pro): user access to the hidraw nodes tools/isp.py needs.
#   sudo cp tools/udev/70-ducky.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# The 70- prefix matters: uaccess tags must be applied before 73-seat-late.rules.
#
# These match the node's own DEVPATH, e.g. .../1-6.2:1.0/0003:3233:1311.0005/hidraw/hidraw0, because udev
# requires all ATTRS{} keys in one rule to match the same parent device: bInterfaceNumber (USB interface) and
# idVendor (USB device) can't be combined. HID device names use upper-case hex.

# App mode: only the command interface (USB interface 0) of each model's stock firmware: One 3, One 3 TKL, One 3
# RGB, One 3 TKL RGB, One 3 SF RGB, One 3 Mini RGB. The keyboard interfaces stay root-only so no user process can
# read keystrokes from them.
KERNEL=="hidraw*", DEVPATH=="*:1.0/0003:3233:1011.*|*:1.0/0003:3233:8011.*|*:1.0/0003:3233:1311.*|*:1.0/0003:3233:8311.*|*:1.0/0003:3233:5311.*|*:1.0/0003:3233:6311.*", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# QMK keymap `via`: only the raw HID interface (USB interface 2) that VIA uses. Interfaces 0 and 1 carry keystrokes.
KERNEL=="hidraw*", DEVPATH=="*:1.2/0003:3233:2108.*", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Stock LDROM bootloader: each model's Ducky ID, in the same order, and the Nuvoton ID the updaters also accept.
KERNEL=="hidraw*", DEVPATH=="*/0003:3233:1010.*|*/0003:3233:8010.*|*/0003:3233:1310.*|*/0003:3233:8310.*|*/0003:3233:5310.*|*/0003:3233:6310.*", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", DEVPATH=="*/0003:0416:3F00.*", MODE="0660", GROUP="plugdev", TAG+="uaccess"
